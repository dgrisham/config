#!/usr/bin/env zsh

# NixOS/iwd rewrite of the old wpa_supplicant+dhcpcd script. No sudo needed -
# iwd's D-Bus service handles privilege separation itself. iwd also does its
# own DHCP once connected (`EnableNetworkConfiguration` in main.conf / the
# NixOS iwd module settings), so there's no separate dhcpcd step anymore.
#
# get_networks()'s table parsing is written against iwctl's documented output
# format but not verified against a live `iwctl station wlan0 get-networks`
# on this machine (wpa_supplicant currently owns wlan0, and iwd contends with
# it for the radio via nl80211 - didn't want to risk the live connection to
# test). Verify the parsing once this actually replaces wpa_supplicant.

wifi_dev="wlan0"
wifi_password_log="$HOME/.local/share/wifi/passwords"

# Prompts for the passphrase itself (instead of letting `iwctl` prompt invisibly)
# so it can be logged to $wifi_password_log - iwd's own storage only keeps the
# derived PreSharedKey, not the plaintext, and is root-owned anyway. Leave the
# prompt blank for open networks or networks iwd already knows.
wifi_connect() {
    local ssid="$1"
    [[ -z "$ssid" ]] && return 1
    local password
    read -rs "password?Passphrase (blank if open/already known): "
    echo
    if [[ -n "$password" ]]; then
        iwctl --passphrase "$password" station "$wifi_dev" connect "$ssid"
        mkdir -p "$(dirname "$wifi_password_log")"
        [[ -f "$wifi_password_log" ]] || { touch "$wifi_password_log"; chmod 600 "$wifi_password_log"; }
        echo "$ssid:$password" >> "$wifi_password_log"
    else
        iwctl station "$wifi_dev" connect "$ssid"
    fi
}

wifi_disconnect() {
    iwctl station "$wifi_dev" disconnect
}

# strips the table borders/header and the trailing security+signal columns,
# leaving just the network name (which may itself contain spaces).
get_networks() {
    iwctl station "$wifi_dev" get-networks 2>/dev/null | perl -ne '
        s/\e\[[\d;]*[a-zA-Z]//g;
        next if /^\s*-+\s*$/;
        next if /Available networks/;
        next if /Network name/;
        s/^\s*>?\s*//;
        s/\s+(?:open|psk|8021x|wep)\s+\S*\s*$//;
        s/\s+$//;
        print "$_\n" if length;
    '
}

wifi_scan() {
    iwctl station "$wifi_dev" scan
    sleep 2
    get_networks | sort -u
}

# interactive picker - trigger a scan, fzf over the results, connect to the pick.
wifi_menu() {
    local ssid="$(wifi_scan | fzf)"
    [[ -z "$ssid" ]] && return 1
    wifi_connect "$ssid"
}

wifi_list_known() {
    iwctl known-networks list
}

wifi_forget() {
    local ssid="$1"
    [[ -z "$ssid" ]] && return 1
    iwctl known-networks "$ssid" forget
}

wifi_command="$1"
[[ -z "$wifi_command" ]] && exit 0
shift
case "$wifi_command" in
    c|connect)
        wifi_connect "$@"
        ;;
    d|disconnect)
        wifi_disconnect "$@"
        ;;
    s|scan)
        wifi_scan "$@"
        ;;
    m|menu)
        wifi_menu "$@"
        ;;
    l|list)
        wifi_list_known "$@"
        ;;
    forget)
        wifi_forget "$@"
        ;;
    r|restart)
        wifi_disconnect
        wifi_connect "$@"
        ;;
    *)
        echo "Unrecognized command: '$wifi_command'"
        ;;
esac
