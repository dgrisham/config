#!/usr/bin/env zsh

kakbin="/opt/homebrew/bin/kak"
[[ -z "$WENV" ]] && { $kakbin $@ ; return 0 }

local server_name=$(sed 's/\//-/g' <<< $WENV)
local base_dir="$WENV_DIR"

if [[ -n "$GIT_WORKTREES" ]]; then
    for worktree_dir in $(git worktree list | cut -d' ' -f1 | grep "$GIT_WORKTREES"); do
        if [[ $PWD/ = $worktree_dir/* ]]; then
            base_dir="$worktree_dir"
            branch=${worktree_dir#"${GIT_WORKTREES}/"}
            server_name="$(sed 's/\//-/g' <<< $branch)"
            break
        fi
    done
fi

local socket_file=$(grep "^$server_name\$" <<< $($kakbin -l))
[[ $socket_file == "" ]] && $kakbin -d -s $server_name -E "cd $base_dir" &
$kakbin -c $server_name $@
