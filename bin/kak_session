#!/usr/bin/env zsh

kakbin="$HOMEBREW_ROOT/bin/kak"
[[ -z "$WENV" ]] && { $kakbin $@ ; return 0 }

local server_name=$(sed 's/\//-/g' <<< $WENV)
local base_dir="$WENV_DIR"

local toplevel=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -n "$GIT_WORKTREES" && -n "$toplevel" && "$toplevel/" == "$GIT_WORKTREES"/* ]]; then
    base_dir="$toplevel"
    server_name="$(sed 's/\//-/g' <<< ${toplevel#"${GIT_WORKTREES}/"})"
elif [[ -n "$JJ_WORKSPACES" && -n "$toplevel" && "$toplevel/" == "$JJ_WORKSPACES"/* ]]; then
    base_dir="$toplevel"
    server_name="$(sed 's/\//-/g' <<< ${toplevel#"${JJ_WORKSPACES}/"})"
fi

local socket_file=$(grep "^$server_name\$" <<< $($kakbin -l))
[[ $socket_file == "" ]] && $kakbin -d -s $server_name -E "cd $base_dir" &
$kakbin -c $server_name $@
