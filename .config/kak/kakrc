        evaluate-commands %sh{
            base_dir="$(pwd)/"
            file_path="${kak_buffile#$base_dir}"
            if [[ "$file_path" =~ _templ\.go$ ]]; then
                templ_file="${file_path%_templ.go}.templ"
                if [ -f "$templ_file" ]; then
                    echo "edit $templ_file"
                    echo "lsp-goto-document-symbol ${kak_opt_templ_lsp_target_symbol}"
                else
                    echo "echo -debug 'No corresponding .templ file found for $file_path'"
                fi
            else
                echo "echo -debug '$file_path Not a _templ.go file'"
            fi
        }
    }

    unmap global lsp d
    map global lsp d ':lsp-definition-templ<ret>' -docstring 'Go to definition (Templ-aware)'
