# ===============

def tig-blame -override -docstring 'Open blame in tig for current file and line' %{
    # Note here we aren't passing any command on resume of kakoune
    suspend-and-resume " tig blame +%val{cursor_line} %val{buffile}"
}

def tig-blame-selection -docstring "Run tig -L on the selected lines" %{
	execute-keys <a-:>
	set-register d %sh{
		anchor=${kak_selection_desc%,*}
		anchor_line=${anchor%.*}
		cursor=${kak_selection_desc#*,}
		cursor_line=${cursor%.*}
		printf %s "tig -C $(git rev-parse --show-toplevel) -L$anchor_line,$cursor_line:${kak_buffile##$(pwd)/}"
	}
	suspend-and-resume %reg{d}
}

