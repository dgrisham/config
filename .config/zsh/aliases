# jq but don't break when processing non-json lines ( this is a function just to avoid insane quote management)
jqr() { jq -R -r '. as $line | try fromjson catch $line' }
jwt-decode() {
    local payload=$(echo "$1" | cut -d. -f2)
    echo "${payload}==" | base64 -d | jq .
}



