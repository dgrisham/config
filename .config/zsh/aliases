}

# $EDITOR <today's_date>.md
# -------------------------
edit_today() {
    local format='%Y-%m-%d'
    local fname=`date +$format`
    [[ -n "$1" ]] && fname+="-$1"
    fname+=".md"
    $EDITOR "$fname"
}
alias et='edit_today'

edit_week() {
    local format='%Y-%m-%d'
    local which_monday='last-monday'
    [[ $(date +%a) == 'Mon' ]] && which_monday='this-monday'
    $EDITOR "`date -d$which_monday +$format`.md"
}
alias ew='edit_week'

