# Ghostty config

# Font
font-family = Inconsolata
font-size = 14

# Theme
theme = Builtin Tango Dark

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = true
macos-titlebar-style = tabs

# No ligatures
font-feature = -liga
font-feature = -calt

# Cursor
cursor-style = bar
cursor-style-blink = false

# macOS specific
macos-option-as-alt = true
quit-after-last-window-closed = true

# Disable link detection (no URL/path highlighting or hover effects)
link-url = false
